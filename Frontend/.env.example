# Public backend URL only. For local Vite development, the /api proxy is used.
VITE_API_BASE_URL=/api

# Public Firebase browser configuration. These are not AI-provider credentials.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional Firebase services / analytics:
# VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
